{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Sensor Pico 2 UF2",
            "type": "process",
            "command": "${env:USERPROFILE}\\.pico-sdk\\cmake\\v4.3.4\\bin\\cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}\\firmware\\build",
                "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
